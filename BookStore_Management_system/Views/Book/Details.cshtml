@model Book

<h2>Book Details</h2>

<div class="card">
    <div class="card-body">

        <h4>@Model.Title</h4>

        <hr />

        <p><strong>Author:</strong> @Model.Author</p>

        <p><strong>ISBN:</strong> @Model.ISBN</p>

        <p><strong>Price:</strong> @Model.Price</p>

        <p><strong>Quantity:</strong> @Model.Quantity</p>

        <p><strong>Category:</strong> @Model.Category?.Name</p>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>
</div>