@model IEnumerable<Book>

<h2>Books</h2>
<form asp-action="Index" method="get" class="mb-3">

    <input type="text"
           name="searchString"
           value="@ViewBag.SearchString"
           placeholder="Search by title or author..."
           class="form-control" />

    <button type="submit" class="btn btn-primary mt-2">
        Search
    </button>

    <a asp-action="Index" class="btn btn-secondary mt-2">
        Clear
    </a>

</form>
<a asp-action="Create" class="btn btn-success mb-3">
    Add New Book
</a>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Author</th>
            <th>ISBN</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Id</td>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.ISBN</td>
                <td>@book.Price</td>
                <td>@book.Quantity</td>
                <td>@book.Category?.Name</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@book.Id"
                       class="btn btn-primary">Edit</a>

                    <a asp-action="Delete"
                       asp-route-id="@book.Id"
                       class="btn btn-danger">Delete</a>

                    <a asp-action="Details"
                       asp-route-id="@book.Id"
                       class="btn btn-info">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
